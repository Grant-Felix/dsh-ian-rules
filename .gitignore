# 依赖与构建产物（本插件零依赖，这里主要是防手滑）
node_modules/
pnpm-lock.yaml
package-lock.json
yarn.lock

# 本地运行产物
*.log
*.tmp
ian-rules.json
ian-rules.json.bak
# 更名前历代的数据文件：用户本机可能还留着，别让工作区变脏
agent-rules.json
agent-rules.json.bak
dev-rules.json
dev-rules.json.bak

# 隔离沙箱（scripts/sandbox.sh 的 DSH_HOME，是本地环境不是仓库内容）
.sandbox/
# 沙箱里 pnpm 无法从全局 store 硬链接，于是在仓库根落一个本地 store
.pnpm-store/
# 本地视觉核验留档（无头 Chrome 驱动 + 截图，不属于仓库内容）
.visual/

# 编辑器与系统
.DS_Store
.idea/
.vscode/
*.swp
