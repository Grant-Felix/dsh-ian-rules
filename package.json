{
  "name": "dsh-ian-rules",
  "version": "26.10.6-2",
  "description": "项目开发规则：DSH 开源插件（MIT，供所有人使用、学习和研究）。在 Web GUI 右侧栏提供「开发规则」面板（与「Docker 容器」并列，全局规则 + 按项目覆盖），并把当前项目生效的规则自动注入每个会话的系统提示，让 agent 开发项目时自动遵守；另含 ian_rules 工具，便于在对话里直接维护规则。",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "rules",
    "ian-rules",
    "prompt",
    "web"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "NOTICE.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Grant-Felix/dsh-ian-rules.git"
  },
  "homepage": "https://github.com/Grant-Felix/dsh-ian-rules#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check lib/index.js && node --check lib/rules.js && node --check lib/scene.js && node --check lib/client.js && node scripts/check-identity.mjs && node --test",
    "check:identity": "node scripts/check-identity.mjs",
    "sandbox": "bash scripts/sandbox.sh boot",
    "sandbox:check": "bash scripts/sandbox.sh check",
    "sandbox:clean": "bash scripts/sandbox.sh clean"
  },
  "license": "MIT"
}
